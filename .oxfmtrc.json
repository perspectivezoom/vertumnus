{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "public",
    ".claude",
    // The generated transcript is served to the browser as-is, so it stays minified —
    // formatting it would roughly treble a file whose whole job is to be fetched.
    "data/transcript/__generated__"
  ],
  "overrides": [
    {
      // Raw data caches (written by data/raw/format.ts). oxfmt formats these, but they
      // are read back with strict JSON.parse, so trailing commas would make them unparseable.
      "files": ["data/raw/**"],
      "options": { "trailingComma": "none" }
    }
  ]
}
