---
import type { Region } from '@/data/types';
import { dimensions, LEVEL_FILL, monthTicks, spanRects } from '@/lib/poster/geometry';

interface Props {
  region: Region;
}

const { region } = Astro.props;
const d = dimensions(region.items.length);
const months = monthTicks(d);
---

<svg
  class="poster"
  viewBox={`0 0 ${d.width} ${d.height}`}
  role="img"
  aria-label={`In-season produce for ${region.name}`}
>
  {
    months.map((m) => (
      <text class="month" x={m.x} y={d.gridTop - 18} text-anchor="middle">
        {m.label}
      </text>
    ))
  }

  {
    region.items.map((item, i) => {
      const y = d.gridTop + i * d.rowHeight;
      return (
        <g>
          <text class="produce" x={8} y={y + d.rowHeight / 2}>
            {item.name}
          </text>
          {item.spans.map((s) =>
            spanRects(s.from, s.to, d).map((r) => (
              <rect
                x={r.x}
                y={y + 8}
                width={r.width}
                height={d.rowHeight - 16}
                rx={3}
                fill={LEVEL_FILL[s.level]}
              />
            )),
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .poster {
    display: block;
    width: 100%;
    height: auto;
    font-family: system-ui, sans-serif;
  }
  .month {
    font-size: 13px;
    fill: #555;
  }
  .produce {
    font-size: 15px;
    fill: #222;
    dominant-baseline: middle;
  }
</style>
